<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LocalCopilot_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="10">

            <TextBlock
                Text="Local AI Desktop Copilot"
                FontSize="28"
                FontWeight="SemiBold" />

            <TextBlock
                Text="M2.1  Low-Resolution Change Detection"
                FontSize="18"
                Opacity="0.7"
                Margin="0,0,0,18" />

            <TextBlock
                Text="Process"
                FontWeight="SemiBold" />

            <TextBlock
                x:Name="ProcessNameText"
                Text="Waiting..."
                FontSize="18" />

            <TextBlock
                Text="Window title"
                FontWeight="SemiBold"
                Margin="0,12,0,0" />

            <TextBlock
                x:Name="WindowTitleText"
                Text="Waiting..."
                TextWrapping="Wrap"
                FontSize="18" />

            <TextBlock
                Text="Process ID"
                FontWeight="SemiBold"
                Margin="0,12,0,0" />

            <TextBlock
                x:Name="ProcessIdText"
                Text="-" />

            <TextBlock
                Text="HWND"
                FontWeight="SemiBold"
                Margin="0,12,0,0" />

            <TextBlock
                x:Name="WindowHandleText"
                Text="-" />

            <TextBlock
                Text="Last observed"
                FontWeight="SemiBold"
                Margin="0,12,0,0" />

            <TextBlock
                x:Name="LastObservedText"
                Text="-" />

            <Button
                Content="Probe capture target"
                Click="CaptureTargetProbeButton_Click"
                HorizontalAlignment="Left"
                Margin="0,20,0,0" />

            <TextBlock
                Text="Capture target"
                FontWeight="SemiBold"
                Margin="0,10,0,0" />

            <TextBlock
                x:Name="CaptureTargetStatusText"
                Text="Not tested"
                TextWrapping="Wrap" />

            <Button
                Content="Capture one frame (RAM)"
                Click="CaptureOneFrameButton_Click"
                HorizontalAlignment="Left"
                Margin="0,14,0,0" />

            <TextBlock
                Text="Captured frame"
                FontWeight="SemiBold"
                Margin="0,10,0,0" />

            <TextBlock
                x:Name="CapturedFrameStatusText"
                Text="Not captured"
                TextWrapping="Wrap" />

            <TextBlock
                Text="M2.1 change detection probe"
                FontWeight="SemiBold"
                Margin="0,22,0,0" />

            <Button
                Content="Sample change @ 640 px"
                Click="Change640Button_Click"
                HorizontalAlignment="Left"
                Margin="0,6,0,0" />

            <Button
                Content="Sample change @ 960 px"
                Click="Change960Button_Click"
                HorizontalAlignment="Left" />

            <TextBlock
                x:Name="ChangeDetectionStatusText"
                Text="No change samples yet"
                TextWrapping="Wrap"
                Margin="0,6,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>